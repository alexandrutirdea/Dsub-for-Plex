	<!--
		Modern-theme surfaces that differ between Black and White. Every DSub theme
		defines these (the two bases below cover all of them), so the ?attr lookups
		in the shared card and bottom-nav resources always resolve.
	-->
	<attr name="modernCardSurface" format="color"/>
	<!-- The surface a bottom sheet is drawn on, lifted off the screen behind it. -->
	<attr name="sheetSurface" format="color"/>
	<attr name="bottomNavInactiveColor" format="color"/>
	<attr name="collectionFieldBackground" format="reference"/>
	<!-- The line that separates a bar from the content it sits against. -->
	<attr name="dividerHairline" format="color"/>

	<!--
		Now Playing surfaces. Fixed dark in every theme but White, which flips the
		screen to a light ground; routing them through attributes lets that one theme
		override without a second copy of the layout. Every DSub theme defines these
		(the two bases below carry the dark defaults), so the ?attr lookups in the
		Now Playing layout, styles and drawables always resolve.
	-->
	<attr name="npBackdropTop" format="color"/>
	<attr name="npBackdropBottom" format="color"/>
	<attr name="npToolbarColor" format="color"/>
	<attr name="npToolbarOverlay" format="reference"/>
	<attr name="npPrimaryButton" format="color"/>
	<attr name="npPlayGlyphTint" format="color"/>
	<attr name="npTextPrimary" format="color"/>
	<attr name="npTextSecondary" format="color"/>
	<attr name="npTextTertiary" format="color"/>
	<attr name="npTextQuiet" format="color"/>
	<attr name="npTrack" format="color"/>
	<attr name="npTrackPlayed" format="color"/>

