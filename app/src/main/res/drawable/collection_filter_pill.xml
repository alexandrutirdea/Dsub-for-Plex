<?xml version="1.0" encoding="utf-8"?>
<!--
	A filter that is not holding a value. Outlined and grey rather than filled red: a
	filled pill reads as switched on, and "Any length" means nothing is switched on. The
	filled form belongs to the actions beside it - play, autoplay, shuffle - and to a
	filter once it actually narrows something, so red on this bar always means active.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
	android:color="#33FFFFFF">
	<item>
		<shape android:shape="rectangle">
			<corners android:radius="12dp"/>
			<stroke
				android:width="1dp"
				android:color="@color/filterChipIdle"/>
			<solid android:color="@android:color/transparent"/>
		</shape>
	</item>
</ripple>
