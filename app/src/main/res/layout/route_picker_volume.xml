<?xml version="1.0" encoding="utf-8"?>
<!--
	The volume of the device the audio is on, directly under that device's row. Indented
	to the row's text so it reads as belonging to it rather than as a row of its own.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:gravity="center_vertical"
	android:orientation="horizontal"
	android:paddingLeft="64dp"
	android:paddingRight="12dp"
	android:paddingBottom="12dp">

	<ImageView
		android:layout_width="20dp"
		android:layout_height="20dp"
		android:src="@drawable/ic_route_volume"
		android:tint="?android:textColorSecondary"
		android:contentDescription="@null"/>

	<SeekBar
		android:id="@+id/route_volume"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:paddingTop="12dp"
		android:paddingBottom="12dp"
		android:progressTint="?attr/colorAccent"
		android:thumbTint="?attr/colorAccent"
		android:progressBackgroundTint="?android:textColorSecondary"/>
</LinearLayout>
