<?xml version="1.0" encoding="utf-8"?>
<!--
	Stands in for an artist the server has no picture of, so the column of faces keeps
	its rhythm instead of leaving holes where the names then look unaligned.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
	<item>
		<shape android:shape="oval">
			<solid android:color="#1F8E8E93"/>
		</shape>
	</item>
	<item
		android:drawable="@drawable/ic_artist_placeholder"
		android:top="9dp"
		android:bottom="9dp"
		android:left="9dp"
		android:right="9dp"/>
</layer-list>
