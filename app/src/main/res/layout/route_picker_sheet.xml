<?xml version="1.0" encoding="utf-8"?>
<!--
	The device picker, shown from any cast button while the audio is on the phone.
	RoutePickerSheet fills route_picker_list with one route_picker_item per device,
	the phone itself first.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:background="@drawable/route_sheet_background"
	android:paddingBottom="12dp">

	<View
		android:layout_width="32dp"
		android:layout_height="4dp"
		android:layout_gravity="center_horizontal"
		android:layout_marginTop="10dp"
		android:alpha="0.4"
		android:background="@drawable/route_sheet_handle"/>

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingLeft="24dp"
		android:paddingRight="24dp"
		android:paddingTop="18dp"
		android:paddingBottom="10dp"
		android:text="@string/route_picker.title"
		android:textColor="?android:textColorPrimary"
		android:textSize="22sp"
		android:textStyle="bold"/>

	<LinearLayout
		android:id="@+id/route_picker_list"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"/>

	<!-- Shown until the first device turns up; the phone's own row is always there above it. -->
	<LinearLayout
		android:id="@+id/route_picker_searching"
		android:layout_width="match_parent"
		android:layout_height="56dp"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingLeft="24dp"
		android:paddingRight="24dp">

		<ProgressBar
			android:layout_width="20dp"
			android:layout_height="20dp"
			android:layout_marginLeft="2dp"
			android:layout_marginRight="22dp"
			android:indeterminateTint="?android:textColorSecondary"/>

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/route_picker.searching"
			android:textColor="?android:textColorSecondary"
			android:textSize="15sp"/>
	</LinearLayout>
</LinearLayout>
