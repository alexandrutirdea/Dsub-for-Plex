<?xml version="1.0" encoding="utf-8"?>
<!--
	The drawer header: who we are talking to, and a chevron that swaps the list below
	between the tabs and the servers.

	It used to be a 178dp stock illustration - blue paper shards left over from the
	first Material themes - with the name laid over the bottom of it. Nothing else in
	the app is blue, so the drawer opened onto a colour scheme of its own. This is the
	same information at a third of the height, on the theme's own surface.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="horizontal"
	android:gravity="center_vertical"
	android:background="?attr/drawerHeaderBackground"
	android:paddingLeft="@dimen/List.Keyline"
	android:paddingRight="@dimen/List.Keyline"
	android:paddingTop="20dp"
	android:paddingBottom="20dp">

	<de.hdodenhof.circleimageview.CircleImageView
		android:id="@+id/header_user_avatar"
		android:layout_width="44dp"
		android:layout_height="44dp"
		android:src="@drawable/ic_drawer_avatar"/>

	<LinearLayout
		android:orientation="vertical"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:layout_marginLeft="@dimen/List.ArtGap">

		<TextView
			android:id="@+id/header_server_name"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:singleLine="true"
			android:ellipsize="end"
			style="?attr/drawerTitleStyle"/>

		<!-- Plex signs in with a token and has no username to show, so this line is
		     often empty; it takes no height when it is. -->
		<TextView
			android:id="@+id/header_user_name"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:singleLine="true"
			android:ellipsize="end"
			style="?attr/drawerSubtitleStyle"/>
	</LinearLayout>

	<ImageView
		android:id="@+id/header_select_image"
		android:src="@drawable/main_select_server_dark"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="center_vertical"/>
</LinearLayout>
