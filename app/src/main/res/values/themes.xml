	<style name="Theme.DSub.Dark" parent="Theme.DSub.Dark.Base">
	</style>
	<!--
		The modern theme. True black throughout with a single red accent, and the app
		bar and status bar the same black as the content so nothing cuts a coloured
		band across the top. The status bar has to be set here: at targetSdk 36 under
		the Android 15 edge-to-edge rules Window.setStatusBarColor is a no-op, so the
		theme attribute is the only lever left.
	-->
	<style name="Theme.DSub.Black.Base" parent="Theme.DSub.Dark.Base">
		<item name="cardBackgroundDrawable">@drawable/card_rounded_corners_modern</item>
		<!--
			The app bar's own icons, on the same 24dp grid as the bottom bar's. The
			inherited set is a decade older and thinner, and the two sat a thumb apart.
			Only this theme and White point at them; the light themes keep the dark-on-
			light drawables they need.
		-->
		<item name="actionbar_start">@drawable/ic_action_play</item>
		<item name="shuffle">@drawable/ic_action_shuffle</item>
		<item name="search">@drawable/ic_action_search</item>
		<item name="refresh">@drawable/ic_action_refresh</item>
		<item name="drawerHome">@drawable/ic_nav_home</item>
		<item name="drawerLibrary">@drawable/ic_nav_library</item>
		<item name="drawerPlaylists">@drawable/ic_nav_playlists</item>
		<item name="drawerHeaderBackground">@color/modernBlack</item>
		<!-- 70% white. The platform's secondary is dimmer than that, and the second
		     line of a row was hard to read against true black. -->
		<item name="android:textColorSecondary">@color/modernTextSecondary</item>
		<item name="android:windowBackground">@color/modernBlack</item>
		<item name="colorPrimary">@color/modernBlack</item>
		<item name="colorPrimaryDark">@color/modernBlack</item>
		<item name="android:statusBarColor">@color/modernBlack</item>
		<item name="android:navigationBarColor">@color/modernBlack</item>
		<item name="colorAccent">@color/modernAccent</item>
		<item name="actionbarBackgroundColor">@color/modernBlack</item>
		<item name="actionModeBackground">@color/modernBlack</item>
	</style>
	<style name="Theme.DSub.Black" parent="Theme.DSub.Black.Base">
	</style>
	<!--
		The White theme: the Black theme flipped to a light ground. It descends from
		Light.Base for the dark-on-light icon set, then paints every surface white and
		turns the body text red. White bars need their own care that black ones did
		not: the status-bar glyphs, the action-bar controls and the spinner text all
		default to white against a coloured bar, so each is switched to a light/dark
		variant here or they would vanish against the white.
	-->
	<style name="Theme.DSub.White.Base" parent="Theme.DSub.Light.Base">
		<item name="cardBackgroundDrawable">@drawable/card_rounded_corners_modern_light</item>
		<!--
			The drawer and bottom bar tint these themselves, so the one white-filled set
			serves both modern themes. The app bar's icons are not tinted and would
			vanish against a white bar, so those stay as Light.Base left them.
		-->
		<item name="drawerHome">@drawable/ic_nav_home</item>
		<item name="drawerLibrary">@drawable/ic_nav_library</item>
		<item name="drawerPlaylists">@drawable/ic_nav_playlists</item>
		<item name="drawerHeaderBackground">@color/modernWhite</item>
		<item name="modernCardSurface">@color/modernSurfaceLight</item>
		<item name="sheetSurface">@color/modernWhite</item>
		<item name="bottomNavInactiveColor">@color/modernTextRedMuted</item>
		<item name="collectionFieldBackground">@drawable/collection_search_field_light</item>
		<!--
			Now Playing flips to white here: a light backdrop, a white toolbar with
			dark controls, a red play disc with a white glyph, and red text in place
			of the white. The art-derived backdrop is skipped in code for this theme,
			so the light gradient below is what shows.
		-->
		<item name="npBackdropTop">@color/modernSurfaceLight</item>
		<item name="npBackdropBottom">@color/modernWhite</item>
		<item name="npToolbarColor">@color/modernWhite</item>
		<item name="npToolbarOverlay">@style/ThemeOverlay.AppCompat.Light</item>
		<item name="npPrimaryButton">@color/modernAccent</item>
		<item name="npPlayGlyphTint">@color/modernWhite</item>
		<item name="npTextPrimary">@color/modernTextRed</item>
		<item name="npTextSecondary">#CCD70015</item>
		<item name="npTextTertiary">#99D70015</item>
		<item name="npTextQuiet">#66D70015</item>
		<item name="npTrack">#33D70015</item>
		<item name="npTrackPlayed">@color/modernTextRed</item>
		<item name="android:windowBackground">@color/modernWhite</item>
		<item name="colorPrimary">@color/modernWhite</item>
		<item name="colorPrimaryDark">@color/modernWhite</item>
		<item name="android:statusBarColor">@color/modernWhite</item>
		<item name="android:navigationBarColor">@color/modernWhite</item>
		<item name="colorAccent">@color/modernAccent</item>
		<item name="actionbarBackgroundColor">@color/modernWhite</item>
		<item name="actionModeBackground">@color/modernWhite</item>
		<item name="android:textColorPrimary">@color/modernTextRed</item>
		<!-- 70% of the text red, matching what Black lifts its secondary text to. -->
		<item name="android:textColorSecondary">@color/modernTextRedSecondary</item>
		<item name="android:windowLightStatusBar">true</item>
		<item name="android:windowLightNavigationBar">true</item>
		<item name="actionbarThemeStyle">@style/ThemeOverlay.AppCompat.Light</item>
		<item name="actionbarPopupStyle">@style/ThemeOverlay.AppCompat.Light</item>
		<item name="actionbarTitleStyle">@style/ActionBarTitle.Red</item>
		<item name="actionbarSubtitleStyle">@style/ActionBarSubtitle.Muted</item>
		<item name="drawerTitleStyle">@style/ActionBarTitle.Red</item>
		<item name="drawerSubtitleStyle">@style/ActionBarSubtitle.Muted</item>
		<item name="android:spinnerItemStyle">@style/LightSpinnerItem</item>
	</style>
