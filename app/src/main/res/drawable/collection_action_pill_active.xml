<?xml version="1.0" encoding="utf-8"?>
<!--
	Autoplay while it is running. The colours invert rather than change - red on white
	instead of white on red - so "on" reads as a pressed-in toggle without introducing
	a second accent colour.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
	android:color="#33000000">
	<item>
		<shape android:shape="rectangle">
			<corners android:radius="12dp"/>
			<solid android:color="@color/collectionActionOn"/>
		</shape>
	</item>
</ripple>
